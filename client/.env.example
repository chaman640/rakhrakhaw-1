VITE_APP_NAME=Rakh Rakhav

# VITE_API_URL — normally iski zarurat NAHI hai, isliye comment me hai.
#
# App by default relative `/api` use karta hai:
#   dev me     -> vite khud 5173 se 5000 pe bhej deta hai (vite.config.js ka proxy)
#   deploy me  -> client aur API dono ek hi URL pe hain, seedha chal jata hai
#
# Sirf tab kholein jab API sach me kisi aur URL pe ho:
# VITE_API_URL=http://localhost:5000/api
