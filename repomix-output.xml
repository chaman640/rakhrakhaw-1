          } /> :


        <>
            {/* Desktop */}
            <div className="hidden md:block">
              <Table columns={columns} rows={items} loading={loading} />
            </div>

            {/* Mobile */}
            <div className="md:hidden">
              {loading ?
            <SkeletonRows /> :

            items.map((item) =>
            <ItemCard
              key={item._id}
              item={item}
              selected={selected.includes(item._id)}
              onSelect={toggleSelect}
              onEdit={(i) => {setFormItem(i);setFormOpen(true);}}
