    });
    check('doosra malik nahi ban saka', r.status === 400, `status ${r.status}`);

    r = await call('POST', '/staff', {
      token: wToken,
      body: { name: 'Same Number', phone: WHOLESALER_PHONE, password: 'staff123', staffRole: 'manager' },
