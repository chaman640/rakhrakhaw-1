// Date ke khaane ko "2026-08-22" chahiye; server poori ISO tareekh bhejta hai
const dateInput = (v) => v ? String(v).slice(0, 10) : '';

// Jo warranty aam taur pe di jaati hai — type karne ki zarurat na pade
const WARRANTY_PRESETS = [
