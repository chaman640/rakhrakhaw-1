          Yahan se order karne ke liye apni dukaan register karein
        </>
      }
      footer={
        <>
          Pehle se account hai?{' '}
          <Link to="/login" className="font-medium text-brand-700 hover:underline">
            Login karein
          </Link>
        </>
      }
