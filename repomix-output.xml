          <p className="text-sm text-slate-600">{linkError}</p>
          <Link to="/login" className="mt-4 text-sm font-medium text-brand-700 hover:underline">
            Login page pe jayein
          </Link>
        </div>
      </AuthShell>
    );
  }

  return (
    <AuthShell
      brandName={invite.businessName}
      logoUrl={invite.logoUrl}
      subtitle={
