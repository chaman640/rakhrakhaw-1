        <Link className="text-brand-700 hover:underline" to="/signup">
          {t('Account banayein')}
        </Link>
        {' · '}
        <Link className="text-brand-700 hover:underline" to="/refund">
          {t('Refund Policy')}
        </Link>
      </p>
    </PolicyShell>
  );
}
