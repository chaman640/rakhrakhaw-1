@import "tailwindcss";

/* ---- Design tokens ---- */
/* Brand colour ek jagah. Badalna ho to sirf yahan badlo, poori app badal jayegi. */
@theme {
  --color-brand-50:  #f0fdfa;
  --color-brand-100: #ccfbf1;
  --color-brand-200: #99f6e4;
  --color-brand-300: #5eead4;
  --color-brand-400: #2dd4bf;
  --color-brand-500: #14b8a6;
  --color-brand-600: #0d9488;
  --color-brand-700: #0f766e;
  --color-brand-800: #115e59;
  --color-brand-900: #134e4a;

  --font-sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
}

html, body, #root { height: 100%; }

body {
  @apply bg-slate-50 text-slate-900 antialiased;
  font-family: var(--font-sans);
}

/* Number columns me digits aligned rahen */
.tabular { font-variant-numeric: tabular-nums; }

/* Focus ring — sab jagah ek jaisa */
.focus-ring {
  @apply outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-1;
}

/* Scrollbar */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-thumb { @apply bg-slate-300 rounded-full; }
::-webkit-scrollbar-thumb:hover { @apply bg-slate-400; }

@media print {
  .no-print { display: none !important; }

  /* Bill A4 pe theek se chhape */
  @page { size: A4; margin: 12mm; }

  html, body { background: #fff !important; }

  /* Sirf bill chhapega — sidebar, header, buttons sab gayab */
  body * { visibility: hidden; }
  .invoice-sheet, .invoice-sheet *,
  .report-sheet, .report-sheet * { visibility: visible; }

  .invoice-sheet {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    max-width: none !important;
    padding: 0 !important;
    box-shadow: none !important;
  }

  /* Row beech me se na kate */
  table { page-break-inside: auto; }
  tr { page-break-inside: avoid; page-break-after: auto; }
  thead { display: table-header-group; }

  /*
    Bill ki table phone pe side me khiskati hai (overflow-x-auto + min-width).
    Chhapte waqt wo dono cheezein nuksaan karti hain — kagaz pe khiskana hota
    hi nahi, aur min-width se table kagaz se chaudi ho jati hai. Isliye print
    pe donon hata dete hain.
  */
  .sheet-scroll { overflow: visible !important; }
  .sheet-scroll > table { min-width: 0 !important; }
}
