        <>
            <Button variant="secondary" icon={Tag} onClick={() => setCategoryOpen(true)}>
              <span className="hidden sm:inline">{t('Categories')}</span>
            </Button>
            <Button variant="secondary" icon={Upload} onClick={() => setImportOpen(true)}>
