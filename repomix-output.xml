                        <span className="tabular text-sm font-medium text-slate-900">
                          {formatMoney(r.itemsTotal)}
                        </span>
                      </div>
                    </div>
                    <ChevronRight size={18} className="shrink-0 text-slate-300" />
                  </button>
            )}
