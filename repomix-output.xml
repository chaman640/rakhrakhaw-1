    <div className="p-4">
      <div className="mb-2 flex items-center justify-between gap-2">
        <span className="text-xs font-semibold uppercase tracking-wide text-slate-400">{t("Item {a0}", { a0:
            index + 1 })}
        </span>
        {onRemove &&
