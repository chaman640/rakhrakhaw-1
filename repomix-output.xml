      <Card className="mb-5" padding={false}>
        <div className="p-4">
          <Chips value={status} onChange={setStatus}
          options={[
          { value: 'all', label: 'Sab' },
          { value: 'PLACED', label: 'Bheja gaya' },
          { value: 'PACKED', label: 'Pack ho raha' },
          { value: 'READY', label: 'Tayyar' },
          { value: 'DELIVERED', label: 'Mil gaya' }]
