# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/rakhrakhav

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Client ka URL — invite link isi se banta hai.
#
# Ek hi URL wale deploy (Render) me ye KHALI CHHOD DEIN —
# app pehli request pe khud pata laga leta hai ki wo kis URL pe chal raha hai.
# Sirf tab bharein jab client aur server sach me alag alag URL pe hon.
CLIENT_URL=http://localhost:5173

# Server ka public URL — local upload ki image ka link isse banta hai.
# Ye bhi ek hi URL wale deploy me khali chhod sakte hain.
SERVER_URL=http://localhost:5000

# Cloudinary — OPTIONAL. Khali chhod do to images local `uploads/` folder me jayengi.
# Production me bharna zaroori hai warna deploy pe images gayab ho jayengi.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
