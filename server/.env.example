# Server
PORT=5000

# ── Ek lakh user ke liye ──
# Pool: ek node ke liye 10 kaafi hai. Bhaar barhe to NODE badhaiye, pool nahi.
MONGO_POOL=10
# Ek IP se ek minute me kitni request. 300 me koi asli aadmi nahi atakta.
RATE_LIMIT_PER_MIN=300
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/rakhrakhav

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Client ka URL — invite link isi se banta hai.
#
# Ek hi URL wale deploy (Render) me ye KHALI CHHOD DEIN —
# app pehli request pe khud pata laga leta hai ki wo kis URL pe chal raha hai.
# Sirf tab bharein jab client aur server sach me alag alag URL pe hon.
CLIENT_URL=http://localhost:5173
# Live pe: CLIENT_URL=https://rakhrakhav.in

# Server ka public URL — local upload ki image ka link isse banta hai.
# Ye bhi ek hi URL wale deploy me khali chhod sakte hain.
SERVER_URL=http://localhost:5000

# ═══════════════════════════════════════════════════════════════════════
# PAISA LAGEGA YA NAHI — EK HI SWITCH
# ═══════════════════════════════════════════════════════════════════════
#
# Bilkul NODE_ENV jaisa. Ek line badlein, server dobara chalayein, ho gaya.
#
#   free  ->  aaj jaisa hi sab kuch, sabke liye khula
#   paid  ->  BECHNE wala hissa plan maangega
#
# Kharidne wala hissa (retailer — maal dekhna, order bhejna, khata dekhna)
# DONO halat me free hi rehta hai. Wajah: retailer se paisa maangne par wo
# aayega hi nahi, aur uske bina wholesaler ke liye app ka matlab hi khatam.
#
# Galat shabd likhne par server saaf error deta hai — chup-chaap "free" nahi
# maan leta. Wo sabse khatarnak jawab hota: "Paid" likh kar aap nishchint ho
# jate aur mahino tak sabko sab muft milta rehta.
BILLING_MODE=free

# Payment fail hone ke baad kitne din tak sab chalta rahega.
# Card ki limit, UPI mandate, bank ka server — fail hona aam hai. Us ek pal me
# poori dukaan band kar dena sabse bura jawab hai.
BILLING_GRACE_DAYS=7

# ── Dukaan ka apna pata — policy ke kagaz aur bill dono me chhapta hai ──
#
# Razorpay ye teeno poore pate ke saath maangta hai; bina inke merchant
# account manzoor hi nahi hota.
COMPANY_NAME=Rakh Rakhav
COMPANY_LEGAL_NAME=
SUPPORT_EMAIL=support@rakhrakhav.in
SUPPORT_PHONE=
COMPANY_ADDRESS=
COMPANY_GSTIN=
PUBLIC_URL=https://rakhrakhav.in

# ── Razorpay ── (BILLING_MODE=paid me ye teeno ZAROORI hain)
#
# Bina inke server shuru hi nahi hota — chup-chaap chalne dena ka matlab hota
# ki plan ka page khulta aur checkout par kuch na hota.
#
# Webhook secret Razorpay Dashboard → Settings → Webhooks me banta hai.
# Webhook ka URL rakhein:  https://rakhrakhav.in/api/billing/webhook
# Event chunein:           payment.captured, payment.failed, order.paid
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ══════════════════ PHONE PE NOTIFICATION (SMS nahi) ══════════════════
#
# Order, payment, stock — sab ka alert phone pe app ke through jata hai,
# bilkul jaise YouTube ya WhatsApp ke aate hain. ISKE PAISE NAHI LAGTE.
# SMS sirf OTP ke liye bachta hai, isliye SMS ka bill bahut kam rehta hai.
#
# Ye do line EK BAAR banti hain:   npm run vapid --prefix server
# Baad me badalne par sab purane phone ka subscription mar jata hai.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rakhrakhav.in

# ══════════════════════════ OTP KA SMS ══════════════════════════
#
# SMS_PROVIDER: apitxt | fast2sms
# Khali chhod dein to APITXT_API_KEY hone par 'apitxt', warna 'fast2sms'.
SMS_PROVIDER=apitxt
SMS_SENDER_ID=

APITXT_API_KEY=

# APITxT ka EXACT URL apne dashboard/docs se copy karke yahan daalein.
# {key} {phone} {sender} {otp} {message} apne aap bhar jate hain.
# (Neeche wala ek aam shakal hai — apne panel wala URL zaroor milaayein.)
APITXT_URL=https://api.apitxt.com/api/v2/sms/send?apikey={key}&mobile={phone}&senderid={sender}&message={message}&type=otp
APITXT_OTP_TEMPLATE=Your Rakh Rakhav OTP is {otp}. Valid for 10 minutes. Do not share it with anyone.

# SMS (Fast2SMS) — purana rasta, ab sirf fallback.
#
# Dev me khali chhod sakte hain: tab OTP asli SMS ki jagah SERVER KE LOG me
# chhapta hai aur signup/forgot-password aaram se test ho jate hain.
# Production me bharna ZAROORI hai — wahan khali hone par saaf error aata hai.
FAST2SMS_API_KEY=

# Cloudinary — OPTIONAL. Khali chhod do to images local `uploads/` folder me jayengi.
# Production me bharna zaroori hai warna deploy pe images gayab ho jayengi.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
